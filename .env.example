GOOGLE_API_KEY=your_google_gemini_api_key_here
# GEMINI_API_KEY is also supported if you prefer that name.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Google Maps Platform key — separate from GOOGLE_API_KEY above (different
# Google Cloud product, different billing). Powers the Google Places
# search/curation endpoints used by the /admin/places page.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Supabase-hosted Postgres connection string. Shared between local dev and
# production — there is no separate local database.
DATABASE_URL=postgresql://user:password@host:port/dbname

# Comma-separated allowlist of login emails allowed to use the shop-curation
# admin endpoints (search Google Places / add a curated shop). Unset means
# nobody passes — this fails closed, not open.
ADMIN_EMAILS=you@example.com

# This backend's own public base URL. Curated shops' photo field stores an
# absolute link back to this backend's own /api/places/photo proxy (see
# that endpoint's comment in main.py for why it has to be a proxy rather
# than Google's raw photo URL), so this needs to be correct for whichever
# environment is running — the Cloud Run URL in production, left as the
# default http://127.0.0.1:8000 for local dev.
# PUBLIC_BASE_URL=https://your-cloud-run-url.run.app
